@page "{ItemId:int?}" // Add the route parameter here
@model LostAndFoundWebUi.Pages.AdminClaimsModel
@{
    ViewData["Title"] = "Manage Claims";
}

<div class="container">
    @if (Model.ItemId.HasValue)
    {
        <h1>Claims for Item ID: @Model.ItemId (Item: @Model.ItemTitle)</h1>
    }
    else
    {
        <h1>Manage Claims (Please select an item)</h1>
    }

    <p>Review and manage all claims for the selected item.</p>

    <div class="claims-list">
        @if (Model.Claims.Any())
        {
            @foreach (var claim in Model.Claims)
            {
                <div class="claim-item pending" data-claim-id="@claim.ClaimId" data-status="pending" data-type="lost">
                    <div class="claim-header">
                        <h3>Claim #@claim.ClaimId (Item ID: @claim.ItemId)</h3>
                        <span class="status-badge pending">Pending</span>
                    </div>
                    @* ... (Claim Details are unchanged) ... *@
                    <div class="claim-details">
                        <div class="detail-row">
                            <div class="detail-col">
                                <strong>Claimant:</strong> @claim.CreatedBy<br>
                                <strong>Submitted:</strong> @claim.CreatedDate.ToShortDateString()
                            </div>
                            <div class="detail-col">
                                <strong>Location Claimed:</strong> @claim.Location<br>
                                <strong>Date Lost (Claimant):</strong> @claim.DateLost.ToShortDateString()
                            </div>
                        </div>
                        <div class="claim-reason">
                            <strong>Claim Reason:</strong> @claim.Reason
                        </div>
                    </div>

                    @* -------------------------------------------------------------------- *
                     * NEW: Form for managing claim status (Approve/Reject)
                     * -------------------------------------------------------------------- *@
                    <div class="claim-actions">
                        <form method="post" asp-page-handler="ManageClaim">
                            @* Hidden field to pass the ClaimId, necessary for the handler *@
                            <input type="hidden" name="ClaimId" value="@claim.ClaimId" />

                            <button class="btn-approve"
                                    type="submit"
                                    name="IsApproved"
                                    value="true"
                                    onclick="return confirm('Are you sure you want to approve Claim #@claim.ClaimId?');">
                                Approve
                            </button>

                            <button class="btn-reject"
                                    type="submit"
                                    name="IsApproved"
                                    value="false"
                                    onclick="return confirm('Are you sure you want to reject Claim #@claim.ClaimId?');">
                                Reject
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">No claims found for this item.</div>
        }
    </div>
</div>

<style>
    .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
    }

    .filter-section {
        display: flex;
        gap: 30px;
        margin-bottom: 30px;
        padding: 20px;
        background: #f8fafc;
        border-radius: 8px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .filter-group label {
        font-weight: 600;
        color: #374151;
    }

    .filter-group select {
        padding: 8px 12px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        background: white;
    }

    .claims-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .claim-item {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-left: 4px solid #6b7280;
    }

    .claim-item.pending {
        border-left-color: #f59e0b;
    }

    .claim-item.approved {
        border-left-color: #10b981;
    }

    .claim-item.rejected {
        border-left-color: #ef4444;
    }

    .claim-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .claim-header h3 {
        margin: 0;
        color: #1e3a8a;
    }

    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .status-badge.pending {
        background: #fef3c7;
        color: #d97706;
    }

    .status-badge.approved {
        background: #d1fae5;
        color: #065f46;
    }

    .status-badge.rejected {
        background: #fee2e2;
        color: #dc2626;
    }

    .claim-details {
        margin-bottom: 15px;
    }

    .detail-row {
        display: flex;
        gap: 40px;
        margin-bottom: 15px;
    }

    .detail-col {
        flex: 1;
    }

    .claim-reason, .claim-evidence {
        margin: 10px 0;
        padding: 10px;
        background: #f8fafc;
        border-radius: 5px;
    }

    .claim-actions {
        display: flex;
        gap: 10px;
    }

    .btn-approve {
        background: #10b981;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 500;
    }

    .btn-reject {
        background: #ef4444;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 500;
    }

    .btn-view-details {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 500;
    }
</style>