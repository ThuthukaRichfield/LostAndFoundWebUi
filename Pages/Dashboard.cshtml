@page
@model LostAndFoundWebUi.Pages.DashboardModel
@{
    ViewData["Title"] = "Lost & Found - Dashboard";
}

<!-- Welcome Message -->
<div style="background: #e0f2fe; padding: 20px; border-radius: 10px; margin-bottom: 25px; border-left: 4px solid #1e3a8a;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2 style="margin: 0; color: #1e3a8a;">Welcome, @Model.DisplayName!</h2>
            <p style="margin: 5px 0 0 0; color: #475569;">
                Role: <strong>@Model.UserRole</strong> | 
                Email: @Model.Username
            </p>
        </div>
        <div>
            <a href="/Logout" style="background: #ef4444; color: white; padding: 8px 16px; border-radius: 5px; text-decoration: none;">Logout</a>
        </div>
    </div>
</div>

<!-- Search Bar -->
<div class="search-container">
    <div class="search-box">
        <span class="search-icon">🔍</span>
        <input type="text" placeholder="Search for items..." class="search-input" id="searchInput">
        <button class="search-btn" onclick="filterItems()">Search</button>
    </div>
</div>

<!-- Filter Menu -->
<div class="menu">
    <a href="#" class="filter-link active" data-filter="all">All</a> ||
    <a href="#" class="filter-link" data-filter="lost">Lost items</a> ||
    <a href="#" class="filter-link" data-filter="found">Found items</a> ||
    <a href="#" class="filter-link" data-filter="myitems">My items</a>
</div>

<hr />

<!-- Items Container -->
<div class="items" id="itemsContainer">
    <!-- Lost Items -->
    <div class="item lost" data-type="lost" data-user="student1">
        <strong>LOST: Blue hat</strong>
        <p>Lost near library on Monday</p>
        <small>Posted: 2 days ago</small>
        <div class="item-actions">
            <button class="claim-btn" onclick="location.href='/ClaimItem?ItemId=1&ItemName=Blue Hat&ItemType=Lost&Location=Library&Date=2024-01-15&Description=Blue cap with school logo'">Claim Item</button>
        </div>
    </div>
    
    <div class="item lost" data-type="lost" data-user="student2">
        <strong>LOST: Red jacket</strong>
        <p>Lost in parking lot</p>
        <small>Posted: 3 hours ago</small>
        <div class="item-actions">
            <button class="claim-btn" onclick="location.href='/ClaimItem?ItemId=3&ItemName=Red Jacket&ItemType=Lost&Location=Parking Lot&Date=2024-01-16&Description=Red waterproof jacket'">Claim Item</button>
        </div>
    </div>

    <!-- Found Items -->
    <div class="item found" data-type="found" data-user="staff1">
        <strong>FOUND: Notebook</strong>
        <p>Found in cafeteria</p>
        <small>Posted: 1 day ago</small>
        <div class="item-actions">
            <button class="claim-btn" onclick="location.href='/ClaimItem?ItemId=2&ItemName=Notebook&ItemType=Found&Location=Cafeteria&Date=2024-01-14&Description=Spiral notebook with physics notes'">Claim Item</button>
        </div>
    </div>

    <div class="item found" data-type="found" data-user="admin">
        <strong>FOUND: Water bottle</strong>
        <p>Found in gym</p>
        <small>Posted: 5 hours ago</small>
        <div class="item-actions">
            <button class="claim-btn" onclick="location.href='/ClaimItem?ItemId=4&ItemName=Water Bottle&ItemType=Found&Location=Gym&Date=2024-01-16&Description=Blue stainless steel bottle'">Claim Item</button>
        </div>
    </div>

    <!-- My Items (for current user) -->
    <div class="item lost my-item" data-type="lost" data-user="@Model.Username">
        <strong>LOST: Math textbook</strong>
        <p>Lost in room 205</p>
        <small>Posted: 1 week ago | This is your item</small>
        <div class="item-actions">
            <button class="edit-btn">Edit</button>
        </div>
    </div>
</div>

<div class="pagination">
    <button>1</button>
    <button>2</button>
    <button>3</button>
    <button>4</button>
</div>

<div class="bottom-buttons">
    <button class="report-lost" onclick="location.href='/ReportLost'">Report lost item</button>
    <button class="report-found" onclick="location.href='/ReportFound'">Report found item</button>
</div>

<style>
    .search-container {
        margin-bottom: 20px;
    }

    .search-box {
        display: flex;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 25px;
        padding: 5px 15px;
        background: white;
        max-width: 500px;
    }

    .search-icon {
        margin-right: 10px;
        font-size: 1.1rem;
    }

    .search-input {
        flex: 1;
        border: none;
        outline: none;
        padding: 8px 0;
        font-size: 1rem;
    }

    .search-btn {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 20px;
        cursor: pointer;
        margin-left: 10px;
    }

    .menu {
        margin-bottom: 20px;
        font-weight: 500;
    }

    .filter-link {
        text-decoration: none;
        color: #333;
        font-size: 1rem;
        margin: 0 10px;
        cursor: pointer;
    }

    .filter-link.active {
        text-decoration: underline;
        color: #1e3a8a;
        font-weight: bold;
    }

    .items {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin-bottom: 20px;
    }

    .item {
        border: 1px solid #ccc;
        border-radius: 10px;
        padding: 15px;
        background-color: #fefefe;
        text-align: left;
        display: block; /* Will be toggled by JavaScript */
    }

    .item.lost {
        border-left: 6px solid #ef4444;
    }

    .item.found {
        border-left: 6px solid #10b981;
    }

    .my-item {
        background-color: #f0f9ff !important;
        border: 2px dashed #3b82f6 !important;
    }

    .item-actions {
        margin-top: 10px;
        display: flex;
        gap: 10px;
    }

    .claim-btn {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 500;
    }

    .edit-btn {
        background: #f59e0b;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: 500;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin: 20px 0;
    }

    .pagination button {
        background-color: #fde68a;
        border: none;
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 500;
    }

    .bottom-buttons {
        display: flex;
        justify-content: space-between;
        margin-top: 30px;
    }

    .report-lost, .report-found {
        background-color: #3b82f6;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 500;
        font-size: 1rem;
    }

    .report-lost:hover, .report-found:hover {
        background-color: #2563eb;
    }
</style>

<script>
    // Filter items based on selection
    function filterItems() {
        const activeFilter = document.querySelector('.filter-link.active').getAttribute('data-filter');
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const items = document.querySelectorAll('.item');
        const currentUser = '@Model.Username';

        items.forEach(item => {
            const itemType = item.getAttribute('data-type');
            const itemUser = item.getAttribute('data-user');
            const itemText = item.textContent.toLowerCase();
            
            let shouldShow = false;
            
            // Apply filter logic
            switch (activeFilter) {
                case 'all':
                    shouldShow = true;
                    break;
                case 'lost':
                    shouldShow = itemType === 'lost';
                    break;
                case 'found':
                    shouldShow = itemType === 'found';
                    break;
                case 'myitems':
                    shouldShow = itemUser === currentUser;
                    break;
            }
            
            // Apply search filter
            if (shouldShow && searchTerm) {
                shouldShow = itemText.includes(searchTerm);
            }
            
            // Show/hide item
            item.style.display = shouldShow ? 'block' : 'none';
        });
    }

    // Initialize filter links
    document.addEventListener('DOMContentLoaded', function() {
        const filterLinks = document.querySelectorAll('.filter-link');
        
        filterLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                
                // Remove active class from all links
                filterLinks.forEach(l => l.classList.remove('active'));
                
                // Add active class to clicked link
                this.classList.add('active');
                
                // Apply filter
                filterItems();
            });
        });

        // Add search input event listener
        document.getElementById('searchInput').addEventListener('input', filterItems);
        
        // Apply initial filter
        filterItems();
    });
</script>