@page
@model RegisterModel
@{
    ViewData["Title"] = "Register - Lost & Found";
}

<div class="register-container">
    <div class="register-card">
        <h2>Create Account</h2>
        <p class="subtitle">Join the Lost & Found community</p>

        <form method="post">
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="FullName" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="Email" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="Password" class="form-control" required />
            </div>

            <button type="submit" class="btn-register">Register</button>

            <p class="login-link">
                Already have an account?
                <a href="/">Login here</a>
            </p>
        </form>
    </div>
</div>

<style>
    .register-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 85vh;
    }

    .register-card {
        background: white;
        padding: 3rem;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        width: 100%;
        max-width: 400px;
        text-align: center;
    }

    h2 {
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .subtitle {
        color: #475569;
        margin-bottom: 2rem;
    }

    .form-group {
        text-align: left;
        margin-bottom: 1.5rem;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.3rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 1rem;
        outline: none;
        transition: 0.3s;
    }

    .form-control:focus {
        border-color: #1e3a8a;
        box-shadow: 0 0 0 2px #c7d2fe;
    }

    .btn-register {
        width: 100%;
        padding: 0.9rem;
        background: #1e3a8a;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .btn-register:hover {
        background: #3349b9;
    }

    .login-link {
        margin-top: 1.5rem;
        color: #475569;
    }

    .login-link a {
        color: #1e3a8a;
        text-decoration: none;
        font-weight: 600;
    }

    .login-link a:hover {
        text-decoration: underline;
    }
</style>
