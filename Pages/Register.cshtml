@page
@model LostAndFoundWebUi.Pages.RegisterModel
@{
    ViewData["Title"] = "Register - Lost & Found";
}
<div class="register-container">
    <div class="register-card">
        <h2>Create Account</h2>
        <p class="subtitle">Join the Lost & Found community</p>

        <form method="post">

            @* Full Name Field *@
            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" class="form-control" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            @* Email Field *@
            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input type="email" asp-for="Email" class="form-control" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            @* Password Field *@
            <div class="form-group">
                <label asp-for="Password"></label>
                <input type="password" asp-for="Password" class="form-control" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-register">Register</button>

            @* Display API/Model Errors (like "Registration failed...") *@
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-3">
                    <div asp-validation-summary="All"></div>
                </div>
            }
        </form>
    </div>
</div>

<style>
    .register-container {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 85vh;
    }

    .register-card {
        background: white;
        padding: 3rem;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        width: 100%;
        max-width: 400px;
        text-align: center;
    }

    h2 {
        color: #1e3a8a;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .subtitle {
        color: #475569;
        margin-bottom: 2rem;
    }

    .form-group {
        text-align: left;
        margin-bottom: 1.5rem;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.3rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 1rem;
        outline: none;
        transition: 0.3s;
    }

    .form-control:focus {
        border-color: #1e3a8a;
        box-shadow: 0 0 0 2px #c7d2fe;
    }

    .btn-register {
        width: 100%;
        padding: 0.9rem;
        background: #1e3a8a;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .btn-register:hover {
        background: #3349b9;
    }

    .login-link {
        margin-top: 1.5rem;
        color: #475569;
    }

    .login-link a {
        color: #1e3a8a;
        text-decoration: none;
        font-weight: 600;
    }

    .login-link a:hover {
        text-decoration: underline;
    }
</style>
