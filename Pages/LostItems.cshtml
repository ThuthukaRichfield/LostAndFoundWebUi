@page
@model LostAndFoundWebUi.Pages.LostItemsModel
@{
    ViewData["Title"] = "Lost Items";
}

<!-- In the items-grid section, update the item cards: -->
<div class="items-grid">

    @foreach (var item in Model.LostItems)
    {
        // Construct the URL using the data from the item object
        var claimUrl = $"/ClaimItem?ItemId={item.ItemId}&ItemName={item.Title}&ItemType=Lost&Location={item.Category}&Date={item.CreatedDate:yyyy-MM-dd}";

        <div class="item-card" onclick="location.href='@claimUrl'">
            <div class="item-image">
                <img src="https://via.placeholder.com/200x150/ffebee/ef4444?text=@item.Title" alt="@item.Title">
            </div>
            <div class="item-details">
                <h3>@item.Title</h3>
                <p><strong>Category:</strong> @item.Category</p>
                <p><strong>Date:</strong> @item.CreatedDate.ToShortDateString()</p>
                <p><strong>Item ID:</strong> @item.ItemId</p>
                <div class="item-actions">
                    <button class="claim-btn" onclick="event.stopPropagation(); location.href='@claimUrl'">Claim Item</button>
                </div>
            </div>
        </div>
    }

    @if (!Model.LostItems.Any())
    {
        <p>No lost items found.</p>
    }
</div>

<style>
    .item-card {
        cursor: pointer;
        transition: transform 0.2s;
    }

    .item-card:hover {
        transform: translateY(-2px);
    }

    .item-actions {
        margin-top: 10px;
    }

    .claim-btn {
        background: #ef4444;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
        width: 100%;
    }

    .claim-btn:hover {
        background: #dc2626;
    }
</style>