@page
@model LostAndFoundWebUi.Pages.FoundItemsModel
@{
    ViewData["Title"] = "Found Items";
}

<div class="container">
    <h1>Found Items</h1>
    <p>All items found around campus</p>

    <div class="search-container">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="Search found items..." class="search-input">
            <button class="search-btn">Search</button>
        </div>
    </div>

    <div class="items-grid">
        <div class="item-card">
            <div class="item-image">
                <img src="https://via.placeholder.com/200x150/d1fae5/10b981?text=Notebook" alt="Notebook">
            </div>
            <div class="item-details">
                <h3>Black Notebook</h3>
                <p><strong>Found:</strong> Cafeteria</p>
                <p><strong>Date:</strong> 2024-01-15</p>
                <p><strong>Description:</strong> Spiral notebook with physics notes</p>
                <button class="claim-btn">Claim Item</button>
            </div>
        </div>

        <div class="item-card">
            <div class="item-image">
                <img src="https://via.placeholder.com/200x150/d1fae5/10b981?text=Water+Bottle" alt="Water Bottle">
            </div>
            <div class="item-details">
                <h3>Water Bottle</h3>
                <p><strong>Found:</strong> Gym</p>
                <p><strong>Date:</strong> 2024-01-14</p>
                <p><strong>Description:</strong> Blue stainless steel bottle</p>
                <button class="claim-btn">Claim Item</button>
            </div>
        </div>

        <div class="item-card">
            <div class="item-image">
                <img src="https://via.placeholder.com/200x150/d1fae5/10b981?text=USB+Drive" alt="USB Drive">
            </div>
            <div class="item-details">
                <h3>USB Drive</h3>
                <p><strong>Found:</strong> Computer Lab</p>
                <p><strong>Date:</strong> 2024-01-13</p>
                <p><strong>Description:</strong> 32GB SanDisk USB drive</p>
                <button class="claim-btn">Claim Item</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Same styles as LostItems page */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    .search-container {
        margin: 20px 0;
    }

    .search-box {
        display: flex;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 25px;
        padding: 5px 15px;
        background: white;
        max-width: 500px;
    }

    .search-icon {
        margin-right: 10px;
        font-size: 1.1rem;
    }

    .search-input {
        flex: 1;
        border: none;
        outline: none;
        padding: 8px 0;
        font-size: 1rem;
    }

    .search-btn {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 20px;
        cursor: pointer;
        margin-left: 10px;
    }

    .items-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .item-card {
        border: 1px solid #ddd;
        border-radius: 10px;
        overflow: hidden;
        background: white;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .item-image img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .item-details {
        padding: 15px;
    }

    .item-details h3 {
        margin: 0 0 10px 0;
        color: #1e3a8a;
    }

    .item-details p {
        margin: 5px 0;
        color: #555;
    }

    .claim-btn {
        background: #10b981;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        margin-top: 10px;
        width: 100%;
    }

    .claim-btn:hover {
        background: #059669;
    }
</style>