@page
@model LostAndFoundWebUi.Pages.AdminDashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">
    <h1>Admin Dashboard</h1>
    
    <!-- Welcome Message -->
    <div style="background: #e0f2fe; padding: 20px; border-radius: 10px; margin-bottom: 25px; border-left: 4px solid #1e3a8a;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h2 style="margin: 0; color: #1e3a8a;">Welcome, @Model.DisplayName!</h2>
                <p style="margin: 5px 0 0 0; color: #475569;">
                    Role: <strong>@Model.UserRole</strong> | 
                    Email: @Model.Username
                </p>
            </div>
            <div>
                <a href="/Logout" style="background: #ef4444; color: white; padding: 8px 16px; border-radius: 5px; text-decoration: none;">Logout</a>
            </div>
        </div>
    </div>

    <!-- Filter Menu for Admin -->
    <div class="menu">
        <a href="#" class="filter-link active" data-filter="all">All</a> ||
        <a href="#" class="filter-link" data-filter="lost">Lost items</a> ||
        <a href="#" class="filter-link" data-filter="found">Found items</a> ||
        <a href="#" class="filter-link" data-filter="claims">Claims</a>
    </div>

    <div class="search-container">
        <div class="search-box">
            <span class="search-icon">🔍</span>
            <input type="text" placeholder="Search all items..." class="search-input" id="searchInput">
            <button class="search-btn" onclick="filterItems()">Search</button>
        </div>
    </div>

    <!-- Items Container -->
    <div class="items-timeline" id="itemsContainer">
        <!-- Lost Items -->
        <div class="timeline-item" data-type="lost" data-status="active">
            <div class="timeline-marker lost"></div>
            <div class="timeline-content">
                <h4>Blue Baseball Cap</h4>
                <p><strong>Type:</strong> Lost | <strong>Location:</strong> Library | <strong>Date:</strong> Jan 15, 2024</p>
                <p><strong>Claims:</strong> 2 pending claims</p>
                <div class="timeline-actions">
                    <button class="btn-view-claims" onclick="location.href='/AdminItemClaims?itemId=1'">View Claims</button>
                    <button class="btn-edit">Edit</button>
                </div>
            </div>
        </div>

        <div class="timeline-item" data-type="lost" data-status="active">
            <div class="timeline-marker lost"></div>
            <div class="timeline-content">
                <h4>Red Jacket</h4>
                <p><strong>Type:</strong> Lost | <strong>Location:</strong> Parking Lot | <strong>Date:</strong> Jan 14, 2024</p>
                <p><strong>Claims:</strong> 1 pending claim</p>
                <div class="timeline-actions">
                    <button class="btn-view-claims" onclick="location.href='/AdminItemClaims?itemId=3'">View Claims</button>
                    <button class="btn-edit">Edit</button>
                </div>
            </div>
        </div>

        <!-- Found Items -->
        <div class="timeline-item" data-type="found" data-status="active">
            <div class="timeline-marker found"></div>
            <div class="timeline-content">
                <h4>Notebook</h4>
                <p><strong>Type:</strong> Found | <strong>Location:</strong> Cafeteria | <strong>Date:</strong> Jan 14, 2024</p>
                <p><strong>Claims:</strong> 1 pending claim</p>
                <div class="timeline-actions">
                    <button class="btn-view-claims" onclick="location.href='/AdminItemClaims?itemId=2'">View Claims</button>
                    <button class="btn-edit">Edit</button>
                </div>
            </div>
        </div>

        <div class="timeline-item" data-type="found" data-status="resolved">
            <div class="timeline-marker found"></div>
            <div class="timeline-content">
                <h4>Water Bottle</h4>
                <p><strong>Type:</strong> Found | <strong>Location:</strong> Gym | <strong>Date:</strong> Jan 13, 2024</p>
                <p><strong>Claims:</strong> 0 pending claims</p>
                <div class="timeline-actions">
                    <button class="btn-view-claims" onclick="location.href='/AdminItemClaims?itemId=4'">View Claims</button>
                    <button class="btn-edit">Edit</button>
                </div>
            </div>
        </div>

        <!-- Claim Items (for Claims filter) -->
        <div class="timeline-item claim-item" data-type="claim" data-status="pending">
            <div class="timeline-marker claim"></div>
            <div class="timeline-content">
                <h4>Claim: Blue Baseball Cap</h4>
                <p><strong>Claimant:</strong> Alice Johnson | <strong>Submitted:</strong> Jan 16, 2024</p>
                <p><strong>Status:</strong> Pending Review</p>
                <div class="timeline-actions">
                    <button class="btn-view-claims" onclick="location.href='/AdminClaims'">Review Claim</button>
                    <button class="btn-approve">Approve</button>
                    <button class="btn-reject">Reject</button>
                </div>
            </div>
        </div>

        <div class="timeline-item claim-item" data-type="claim" data-status="pending">
            <div class="timeline-marker claim"></div>
            <div class="timeline-content">
                <h4>Claim: Notebook</h4>
                <p><strong>Claimant:</strong> Bob Smith | <strong>Submitted:</strong> Jan 15, 2024</p>
                <p><strong>Status:</strong> Pending Review</p>
                <div class="timeline-actions">
                    <button class="btn-view-claims" onclick="location.href='/AdminClaims'">Review Claim</button>
                    <button class="btn-approve">Approve</button>
                    <button class="btn-reject">Reject</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 20px;
    }

    .menu {
        margin-bottom: 20px;
        font-weight: 500;
    }

    .filter-link {
        text-decoration: none;
        color: #333;
        font-size: 1rem;
        margin: 0 10px;
        cursor: pointer;
    }

    .filter-link.active {
        text-decoration: underline;
        color: #1e3a8a;
        font-weight: bold;
    }

    .search-container {
        margin-bottom: 30px;
    }

    .search-box {
        display: flex;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 25px;
        padding: 5px 15px;
        background: white;
        max-width: 500px;
    }

    .search-icon {
        margin-right: 10px;
        font-size: 1.1rem;
    }

    .search-input {
        flex: 1;
        border: none;
        outline: none;
        padding: 8px 0;
        font-size: 1rem;
    }

    .search-btn {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 20px;
        cursor: pointer;
        margin-left: 10px;
    }

    .items-timeline {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .timeline-item {
        display: flex;
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .timeline-marker {
        width: 8px;
        border-radius: 4px;
        margin-right: 20px;
    }

    .timeline-marker.lost {
        background: #ef4444;
    }

    .timeline-marker.found {
        background: #10b981;
    }

    .timeline-marker.claim {
        background: #f59e0b;
    }

    .timeline-content {
        flex: 1;
    }

    .timeline-content h4 {
        margin: 0 0 10px 0;
        color: #1e3a8a;
    }

    .timeline-content p {
        margin: 5px 0;
        color: #6b7280;
    }

    .timeline-actions {
        margin-top: 15px;
        display: flex;
        gap: 10px;
    }

    .btn-view-claims {
        background: #3b82f6;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-edit {
        background: #6b7280;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-approve {
        background: #10b981;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-reject {
        background: #ef4444;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
    }
</style>

<script>
    // Filter items based on selection
    function filterItems() {
        const activeFilter = document.querySelector('.filter-link.active').getAttribute('data-filter');
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const items = document.querySelectorAll('.timeline-item');

        items.forEach(item => {
            const itemType = item.getAttribute('data-type');
            const itemText = item.textContent.toLowerCase();
            
            let shouldShow = false;
            
            // Apply filter logic for admin
            switch (activeFilter) {
                case 'all':
                    shouldShow = true;
                    break;
                case 'lost':
                    shouldShow = itemType === 'lost';
                    break;
                case 'found':
                    shouldShow = itemType === 'found';
                    break;
                case 'claims':
                    shouldShow = itemType === 'claim';
                    break;
            }
            
            // Apply search filter
            if (shouldShow && searchTerm) {
                shouldShow = itemText.includes(searchTerm);
            }
            
            // Show/hide item
            item.style.display = shouldShow ? 'flex' : 'none';
        });
    }

    // Initialize filter links
    document.addEventListener('DOMContentLoaded', function() {
        const filterLinks = document.querySelectorAll('.filter-link');
        
        filterLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                
                // Remove active class from all links
                filterLinks.forEach(l => l.classList.remove('active'));
                
                // Add active class to clicked link
                this.classList.add('active');
                
                // Apply filter
                filterItems();
            });
        });

        // Add search input event listener
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', filterItems);
        }
        
        // Apply initial filter
        filterItems();
    });
</script>